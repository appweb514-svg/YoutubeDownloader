<UserControl
    x:Class="YoutubeDownloader.Views.Dialogs.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:YoutubeDownloader.Converters"
    xmlns:dialogs="clr-namespace:YoutubeDownloader.ViewModels.Dialogs"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    Width="440"
    x:DataType="dialogs:SettingsViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock
            Grid.Row="0"
            Margin="16"
            FontSize="19"
            FontWeight="Light"
            Text="{Binding LocalizationManager.SettingsTitle}" />

        <Border
            Grid.Row="1"
            Padding="0,8"
            BorderBrush="{DynamicResource MaterialDividerBrush}"
            BorderThickness="0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">
                    <!--  School  -->
                    <TextBlock
                        Margin="16,8,16,4"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryHueMidBrush}"
                        Text="{Binding LocalizationManager.SchoolSectionLabel}" />

                    <!--  School name  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.SchoolNameTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.SchoolNameLabel}" />
                        <TextBox
                            Width="190"
                            Height="20"
                            DockPanel.Dock="Right"
                            FontSize="13"
                            PlaceholderText="{Binding LocalizationManager.SchoolNamePlaceholderText}"
                            Text="{Binding SchoolName}"
                            Theme="{DynamicResource CompactTextBox}" />
                    </DockPanel>

                    <!--  Default download folder  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.DefaultDownloadDirTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.DefaultDownloadDirLabel}" />
                        <TextBox
                            Width="190"
                            Height="20"
                            DockPanel.Dock="Right"
                            FontSize="13"
                            PlaceholderText="{Binding LocalizationManager.DefaultDownloadDirPlaceholderText}"
                            Text="{Binding DefaultDownloadDirPath}"
                            Theme="{DynamicResource CompactTextBox}">
                            <TextBox.InnerRightContent>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Padding="4"
                                        Command="{Binding ResetDefaultDownloadDirPathCommand}"
                                        IsEnabled="{Binding DefaultDownloadDirPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Theme="{DynamicResource MaterialFlatButton}">
                                        <materialIcons:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            Kind="Close" />
                                    </Button>
                                    <Button
                                        Padding="4"
                                        Command="{Binding BrowseDefaultDownloadDirPathCommand}"
                                        Theme="{DynamicResource MaterialFlatButton}">
                                        <materialIcons:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            Kind="FolderOpen" />
                                    </Button>
                                </StackPanel>
                            </TextBox.InnerRightContent>
                        </TextBox>
                    </DockPanel>

                    <!--  Class preset by default  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.ClassPresetDefaultTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.ClassPresetDefaultLabel}" />
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsClassPresetDefault}" />
                    </DockPanel>

                    <!--  Source file  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.WriteSourceFileTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.WriteSourceFileLabel}" />
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShouldWriteSourceFile}" />
                    </DockPanel>

                    <!--  General  -->
                    <TextBlock
                        Margin="16,16,16,4"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryHueMidBrush}"
                        Text="{Binding LocalizationManager.GeneralSectionLabel}" />

                    <!--  Theme  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.ThemeTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.ThemeLabel}" />
                        <ComboBox
                            Width="160"
                            DockPanel.Dock="Right"
                            ItemsSource="{Binding AvailableThemes}"
                            SelectedItem="{Binding Theme}" />
                    </DockPanel>

                    <!--  Language  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.LanguageTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.LanguageLabel}" />
                        <ComboBox
                            Width="160"
                            DockPanel.Dock="Right"
                            ItemsSource="{Binding AvailableLanguages}"
                            SelectedItem="{Binding Language}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:LanguageToStringConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <!--  Auto-updates  -->
                    <DockPanel
                        Margin="16,8"
                        IsVisible="{Binding IsAutoUpdateAvailable}"
                        LastChildFill="False">
                        <ToolTip.Tip>
                            <TextBlock Inlines="{Binding LocalizationManager.AutoUpdateTooltip, Converter={x:Static converters:MarkdownToInlinesConverter.Instance}}" />
                        </ToolTip.Tip>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.AutoUpdateLabel}" />
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsAutoUpdateEnabled}" />
                    </DockPanel>

                    <!--  Persist authentication  -->
                    <DockPanel IsVisible="{OnPlatform False, Windows=True}" LastChildFill="False">
                        <ToolTip.Tip>
                            <TextBlock Inlines="{Binding LocalizationManager.PersistAuthTooltip, Converter={x:Static converters:MarkdownToInlinesConverter.Instance}}" />
                        </ToolTip.Tip>
                        <TextBlock
                            Margin="16,8"
                            DockPanel.Dock="Left"
                            Text="{Binding LocalizationManager.PersistAuthLabel}" />
                        <ToggleSwitch
                            Margin="16,8"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding IsAuthPersisted}" />
                    </DockPanel>

                    <!--  FFmpeg path  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.FFmpegPathTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.FFmpegPathLabel}" />
                        <TextBox
                            Width="150"
                            Height="20"
                            DockPanel.Dock="Right"
                            FontSize="13"
                            PlaceholderText="{Binding LocalizationManager.FFmpegPathPlaceholderText}"
                            Text="{Binding FFmpegFilePath}"
                            Theme="{DynamicResource CompactTextBox}">
                            <TextBox.InnerRightContent>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Padding="4"
                                        Command="{Binding ResetFFmpegFilePathCommand}"
                                        IsEnabled="{Binding FFmpegFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Theme="{DynamicResource MaterialFlatButton}"
                                        ToolTip.Tip="{Binding LocalizationManager.FFmpegPathResetTooltip}">
                                        <materialIcons:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            Kind="Close" />
                                    </Button>
                                    <Button
                                        Padding="4"
                                        Command="{Binding BrowseFFmpegFilePathCommand}"
                                        Theme="{DynamicResource MaterialFlatButton}"
                                        ToolTip.Tip="{Binding LocalizationManager.FFmpegPathBrowseTooltip}">
                                        <materialIcons:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            Kind="FolderOpen" />
                                    </Button>
                                </StackPanel>
                            </TextBox.InnerRightContent>
                        </TextBox>
                    </DockPanel>

                    <!--  Inject language-specific audio streams  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.InjectAltLanguagesTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.InjectAltLanguagesLabel}" />
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShouldInjectLanguageSpecificAudioStreams}" />
                    </DockPanel>

                    <!--  Inject subtitles  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.InjectSubtitlesTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.InjectSubtitlesLabel}" />
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShouldInjectSubtitles}" />
                    </DockPanel>

                    <!--  Save subtitle files  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.SaveSubtitleFilesTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.SaveSubtitleFilesLabel}" />
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShouldSaveSubtitleFiles}" />
                    </DockPanel>

                    <!--  Preferred subtitle language  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.SubtitleLanguageTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.SubtitleLanguageLabel}" />
                        <TextBox
                            Width="150"
                            Height="20"
                            DockPanel.Dock="Right"
                            FontSize="13"
                            PlaceholderText="{Binding LocalizationManager.SubtitleLanguagePlaceholderText}"
                            Text="{Binding PreferredSubtitleLanguage}"
                            Theme="{DynamicResource CompactTextBox}" />
                    </DockPanel>

                    <!--  Inject tags  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.InjectTagsTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.InjectTagsLabel}" />
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShouldInjectTags}" />
                    </DockPanel>

                    <!--  Skip existing files  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.SkipExistingFilesTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.SkipExistingFilesLabel}" />
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShouldSkipExistingFiles}" />
                    </DockPanel>

                    <!--  File name template  -->
                    <DockPanel Margin="16,8" LastChildFill="False">
                        <ToolTip.Tip>
                            <TextBlock Inlines="{Binding LocalizationManager.FileNameTemplateTooltip, Converter={x:Static converters:MarkdownToInlinesConverter.Instance}}" />
                        </ToolTip.Tip>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.FileNameTemplateLabel}" />
                        <TextBox
                            Width="150"
                            Height="20"
                            DockPanel.Dock="Right"
                            FontSize="13"
                            Text="{Binding FileNameTemplate}"
                            Theme="{DynamicResource CompactTextBox}" />
                    </DockPanel>

                    <!--  Parallel limit  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.ParallelLimitTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.ParallelLimitLabel}" />
                        <StackPanel
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock Text="{Binding ParallelLimit}" />
                            <Slider
                                Width="150"
                                IsSnapToTickEnabled="True"
                                Maximum="10"
                                Minimum="1"
                                TickFrequency="1"
                                Value="{Binding ParallelLimit}" />
                        </StackPanel>
                    </DockPanel>

                    <!--  Maximum download rate  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.MaxDownloadRateTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.MaxDownloadRateLabel}" />
                        <TextBox
                            Width="150"
                            Height="20"
                            DockPanel.Dock="Right"
                            FontSize="13"
                            Text="{Binding MaxDownloadRateKBps}"
                            Theme="{DynamicResource CompactTextBox}" />
                    </DockPanel>

                    <!--  Scheduled start time  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.ScheduledStartTimeTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.ScheduledStartTimeLabel}" />
                        <TextBox
                            Width="150"
                            Height="20"
                            DockPanel.Dock="Right"
                            FontSize="13"
                            PlaceholderText="18:00"
                            Text="{Binding ScheduledStartTime}"
                            Theme="{DynamicResource CompactTextBox}" />
                    </DockPanel>

                    <!--  Administration  -->
                    <TextBlock
                        Margin="16,16,16,4"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryHueMidBrush}"
                        Text="{Binding LocalizationManager.AdminSectionLabel}" />

                    <!--  Admin PIN (not set)  -->
                    <DockPanel
                        Margin="16,8"
                        IsVisible="{Binding !IsAdminPinSet}"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.AdminPinTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.AdminPinLabel}" />
                        <StackPanel
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="4">
                            <TextBox
                                Width="110"
                                Height="20"
                                FontSize="13"
                                PasswordChar="●"
                                PlaceholderText="{Binding LocalizationManager.AdminPinPlaceholderText}"
                                Text="{Binding NewAdminPin}"
                                Theme="{DynamicResource CompactTextBox}" />
                            <Button
                                Padding="8,2"
                                Command="{Binding SetAdminPinCommand}"
                                Content="{Binding LocalizationManager.AdminPinSetButton}"
                                Theme="{DynamicResource MaterialFlatButton}" />
                        </StackPanel>
                    </DockPanel>

                    <!--  Admin PIN (set)  -->
                    <DockPanel
                        Margin="16,8"
                        IsVisible="{Binding IsAdminPinSet}"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.AdminPinTooltip}">
                        <StackPanel
                            DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="6">
                            <materialIcons:MaterialIcon
                                Width="16"
                                Height="16"
                                Kind="LockOutline" />
                            <TextBlock Text="{Binding LocalizationManager.AdminPinActiveLabel}" />
                        </StackPanel>
                        <Button
                            Padding="8,2"
                            DockPanel.Dock="Right"
                            Command="{Binding RemoveAdminPinCommand}"
                            Content="{Binding LocalizationManager.AdminPinRemoveButton}"
                            Theme="{DynamicResource MaterialFlatButton}" />
                    </DockPanel>

                    <!--  Maximum video quality  -->
                    <DockPanel
                        Margin="16,8"
                        LastChildFill="False"
                        ToolTip.Tip="{Binding LocalizationManager.MaxVideoQualityTooltip}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizationManager.MaxVideoQualityLabel}" />
                        <ComboBox
                            Width="160"
                            DockPanel.Dock="Right"
                            ItemsSource="{Binding AvailableMaxVideoQualities}"
                            SelectedItem="{Binding MaxVideoQuality}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:VideoQualityPreferenceToStringConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Close button  -->
        <Button
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Stretch"
            Command="{Binding CloseCommand}"
            Content="{Binding LocalizationManager.CloseButton}"
            IsCancel="True"
            IsDefault="True"
            Theme="{DynamicResource MaterialOutlineButton}" />
    </Grid>
</UserControl>
